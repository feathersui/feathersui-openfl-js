{
  "name": "feathersui-openfl",
  "version": "1.3.1",
  "description": "Feathers UI is a cross-platform framework of user interface components for creative frontend projects. It is especially well-suited for games, interactive data visualizations, and other rich, multimedia experiences. With Feathers UI, you can create native apps for a wide range of devices and platforms — including phones, tablets, desktop computers, game consoles… and you can even deploy to web browsers.",
  "repository": "https://github.com/feathersui/feathersui-openfl-js.git",
  "keywords": [
    "OpenFL",
    "Flash",
    "Haxe"
  ],
  "author": "Josh Tynjala",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/feathersui/feathersui-openfl-js/issues"
  },
  "homepage": "https://feathersui.com/",
  "main": "dist/feathersui-openfl.min.js",
  "files": [
    "dist",
    "lib/**/*.d.ts"
  ],
  "types": "lib/feathers/index.d.ts",
  "dependencies": {
    "actuate": "^1.9.0",
    "openfl": "^9.5.2"
  },
  "devDependencies": {
    "@apache-royale/royale-js": "^0.9.12",
    "brotli-webpack-plugin": "^1.1.0",
    "compression-webpack-plugin": "^12.0.0",
    "del-cli": "^7.0.0",
    "feathersui-openfl-haxelib": "feathersui/feathersui-openfl#v1.3.1",
    "globby": "^16.2.0",
    "haxe": "^5.2.1",
    "hxgenjs": "kevinresol/hxgenjs#7608d34f",
    "lime-haxelib": "openfl/lime#8.3.2",
    "openfl-haxelib": "openfl/openfl#9.5.2",
    "typescript": "~6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-merge": "^6.0.1"
  },
  "haxeDependencies": {
    "haxe": "4.0.5"
  },
  "scripts": {
    "build": "npm run clean && npm run build-lib && npm run gen-lib && npm run build-dist && npm run build-swc",
    "clean": "del lib/_gen/ lib/feathers/ dist/",
    "gen-lib": "cd npm-scripts && node generate-modules.mjs gen-lib",
    "build-lib": "cd npm-scripts && haxe js-lib.hxml && node generate-modules.mjs fix-npm-libs && tsc",
    "build-lib-esm": "cd npm-scripts && node generate-modules.mjs gen-esm",
    "build-swc": "compc -load-config=node_modules/@apache-royale/royale-js/royale-asjs/frameworks/js-config.xml -keep-as3-metadata=JSModule -include-sources=lib -namespace library://ns.feathersui.com/openfl/mxml npm-scripts/mxml-manifest.xml -include-namespaces library://ns.feathersui.com/openfl/mxml -compiler.targets=SWF,JS -warnings=false -external-library-path+=node_modules/openfl/dist/openfl.swc -allow-subclass-overrides=true -output=dist/feathersui-royale-typedefs.swc",
    "build-dist": "npm run build-dist:dev && npm run build-dist:prod",
    "build-dist:dev": "webpack --config webpack.dev.js",
    "build-dist:prod": "webpack --config webpack.prod.js"
  }
}
